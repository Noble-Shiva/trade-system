# Trading System Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Broker API Credentials
# Zerodha Kite Connect
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_ACCESS_TOKEN=your_kite_access_token_here

# Upstox API
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# Angel One Smart API
ANGEL_API_KEY=your_angel_api_key_here
ANGEL_CLIENT_ID=your_angel_client_id_here
ANGEL_PASSWORD=your_angel_password_here
ANGEL_TOTP_SECRET=your_angel_totp_secret_here

# Database Credentials
DB_USERNAME=trading_user
DB_PASSWORD=your_secure_database_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_system

# InfluxDB (if using)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_influxdb_token_here
INFLUX_ORG=trading_org
INFLUX_BUCKET=market_data

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Notifications (optional)
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Trading Settings
INITIAL_CAPITAL=100000
MODE=paper  # paper or live

# System Settings
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Security
SECRET_KEY=your_secret_key_for_encryption_here

# API Rate Limits (optional - for external data sources)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_if_needed
QUANDL_API_KEY=your_quandl_key_if_needed
