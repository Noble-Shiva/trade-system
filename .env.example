# Broker API Credentials
# Copy this file to .env and fill in your credentials

# Zerodha Kite Connect
BROKER_API_KEY=your_zerodha_api_key
BROKER_API_SECRET=your_zerodha_api_secret
BROKER_USER_ID=your_zerodha_user_id

# Angel One (if using)
# BROKER_API_KEY=your_angel_api_key
# BROKER_API_SECRET=your_angel_password
# BROKER_USER_ID=your_angel_client_id
# ANGEL_TOTP_SECRET=your_totp_secret

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Database (optional)
DB_USER=postgres
DB_PASSWORD=your_db_password
